# Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# internal/api/config.go reads each variable below that is not commented out.

# Mist API token (required)
MIST_API_TOKEN=

# Your Mist org ID (required)
MIST_ORG_ID=

# Output format: csv | sqlite (default: csv). The --format flag overrides it.
# SQLite writes data/mist_data.db.
OUTPUT_FORMAT=csv

# Delay between API pages in milliseconds (default: 200)
API_RATE_LIMIT_MS=200

# SSH server config
SSH_PORT=2200
SSH_USER=misthelper
# Set a strong password before deployment. The built-in default is not secret.
SSH_PASSWORD=

# HTTP status and health routes
WEB_PORT=8055

# Planned, not read by this build: ArangoDB and Redis output backends.
# ARANGO_URL=http://localhost:8529
# ARANGO_DB=misthelper
# ARANGO_USER=root
# ARANGO_PASSWORD=
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
