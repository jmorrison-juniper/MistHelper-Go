# Binaries. The leading slash matches only the build output at the repository
# root, so new files under cmd/misthelper/ are not ignored.
/misthelper-go
/misthelper-go.exe
/misthelper
/misthelper.exe

# Runtime data
data/
*.log

# Secrets
.env

# Build artifacts
dist/
*.tar.gz
*.zip

# Editor
.vscode/settings.json
.idea/

# Claude Code local settings and agent scratch. MistHelper ignores this folder
# too, because a worktree in it was once committed as a broken gitlink.
.claude/

# Go
vendor/

# Test binaries (go test -c)
*.test
*.test.exe

# Coverage profiles
coverage
coverage*
*.coverprofile
